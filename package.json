{
  "name": "openclaw-agent-hints",
  "version": "0.1.0",
  "description": "Agent Hint protocol (X-Agent-Hint, v1.0) sender for OpenClaw: session, lifecycle, priority and KV-cache hints over HTTP headers.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "tree-zby",
  "homepage": "https://github.com/tree-zby/openclaw-agent-hints",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tree-zby/openclaw-agent-hints.git"
  },
  "bugs": {
    "url": "https://github.com/tree-zby/openclaw-agent-hints/issues"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./plugin": {
      "types": "./types/index.d.ts",
      "default": "./src/plugin.js"
    }
  },
  "files": [
    "src",
    "types",
    "patches",
    "docs",
    "README.md",
    "PRIVACY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "evidence": "node examples/wire_capture.js",
    "check": "node --check src/index.js && node --test \"tests/*.test.js\""
  },
  "keywords": [
    "agent-hint",
    "openclaw",
    "kv-cache",
    "llm-inference",
    "plugin"
  ]
}
